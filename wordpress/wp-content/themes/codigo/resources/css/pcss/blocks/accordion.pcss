

.wp-block-accordion {

    /* --- Smooth open/close ------------------------------------------------ *
   * The block hides the panel via the `hidden` attribute (display:none),
   * which isn't animatable. Override it, keep the panel in the layout, and
   * collapse it with max-height driven by `.is-open`. `visibility` keeps the
   * collapsed content out of the a11y tree; its transition is delayed so the
   * text doesn't disappear before the close finishes.
   * ---------------------------------------------------------------------- */
   .wp-block-accordion-panel {
    display: block;              /* beats display:none from [hidden]        */
    content-visibility: visible; /* beats hidden="until-found"              */
    overflow: hidden;
    max-height: 0;
    padding-top: 0;              /* avoid a sliver of padding when collapsed */
    visibility: hidden;
    transition:
      max-height 0.4s ease,
      visibility 0s linear 0.4s;
  }

  .wp-block-accordion-item.is-open > .wp-block-accordion-panel {
    max-height: 20rem;           /* ⬅ set just above your tallest panel     */
    visibility: visible;
    transition:
      max-height 0.4s ease,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .wp-block-accordion-panel { transition: none; }
  }


  .wp-block-accordion-item {
    padding-bottom:4vw; /* ~76px */
  }

  /* .wp-block-accordion-heading {
    padding-bottom: 0 !important;
  } */

  .wp-block-accordion-heading__toggle {
    align-items: start;
    padding-top: 0;
    .wp-block-accordion-heading__toggle-title {
      word-break: normal;      /* not break-all */
      overflow-wrap: normal;   /* not break-word / anywhere */
      hyphens: none;           /* in case auto-hyphenation is on */
      transition: color 0.3s ease, opacity 0.3s ease;

      @media  (max-width: 400px) {
        padding-right: 10vw;
      }
      @media  (min-width: 401px) and (max-width: calc(theme("screens.lg") - 1px)) {
        padding-right: 30vw;
      }
      @media  (min-width: theme("screens.lg")) {
        padding-right: 5vw;
      }
    }
    .wp-block-accordion-heading__toggle-icon {
      align-items: start;
      /* Hide the literal "+" from the block markup, draw our own glyph instead */
      font-size: 0;        /* hides the "+" text node */
      line-height: 0;
      width: 30px;
      &::before {
        content: "+";
        /* font-size: 1.5rem; */
        font-size: var(--text-3xl);
        line-height: 1;
        display: inline-block;
      }
    }

    &:hover .wp-block-accordion-heading__toggle-title,
    &:hover .wp-block-accordion-heading__toggle-icon {
      text-decoration: none;
      @media (hover: hover) {
        opacity:0.6;
      }
    }
  }

  /* Kill the 45° rotation the block applies when open */
  .wp-block-accordion-item.is-open > .wp-block-accordion-heading .wp-block-accordion-heading__toggle-icon {
    transform: none;
    /* Open item → show a minus */
    &::before {
      content: "\2212";    /* U+2212 MINUS SIGN — cleaner than a hyphen */
    }
  }
}