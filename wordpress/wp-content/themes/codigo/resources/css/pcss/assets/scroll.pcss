.staggered-fade > p {
  opacity: 0;
}

.staggered-fade.is-visible > p {
  animation: appearsIn 1.2s ease forwards;
}

.staggered-fade.is-visible > p:nth-child(1) {
  animation-delay: 0s;
}

.staggered-fade.is-visible > p:nth-child(2) {
  animation-delay: 0.3s;
}

.staggered-fade.is-visible > p:nth-child(3) {
  animation-delay: 0.6s;
}