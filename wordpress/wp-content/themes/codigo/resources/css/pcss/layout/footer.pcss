footer.content-footer {
  nav .menu-item {
    @apply text-base-sm;
  }

  a {
    @media (hover: hover) {
      &:hover {
        opacity:0.6;
      }
    }
    &.no-hover {
      &:hover {
        opacity: 1;
      }
    }
  }

  .address {
    @apply text-base-sm;
  }

  @media  (max-width: calc(theme("screens.sm") - 1px)) {
    .brand {
      margin-top:0;
    }
    .copyright {
      & > .wp-block-column:first-of-type {
        /* margin-top:30px; */
        margin-top:0;
      }
    }
  }
}